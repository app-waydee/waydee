# ─────────────────────────────────────────────────────────────────────────────
# Waydee Backend — ortam değişkenleri şablonu
# Gerçek değerler depoya GİRMEZ. Üretimde AWS Secrets Manager → ECS görev tanımı.
# Yerelde boş bırakılan değişkenler application.yml'deki geliştirme varsayılanını kullanır.
# ─────────────────────────────────────────────────────────────────────────────

# Profil — üretimde `prod`. prod profili ProductionSecretsGuard'ı açar: geliştirme
# şifresi, zayıf JWT anahtarı, açık Swagger veya sahte ödeme ile açılışı engeller.
SPRING_PROFILES_ACTIVE=
SERVER_PORT=8091

# ── Veritabanı (PostgreSQL 16 + PostGIS) ─────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5442/waydee
DB_USERNAME=waydee
DB_PASSWORD=
DB_POOL_SIZE=20

# ── Redis / Valkey (önbellek, hız sınırlama) ─────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6390
REDIS_PASSWORD=
REDIS_SSL=false

# ── Nesne depolama (S3 / yerelde MinIO) ──────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9010
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=waydee-media
MINIO_REGION=

# ── Güvenlik ────────────────────────────────────────────────────────────────
# En az 64 bayt, Base64:  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=
# Veritabanındaki AI API anahtarlarını AES-256-GCM ile şifreleyen anahtar
# (boşsa JWT_SECRET'tan HKDF ile türetilir).
SECRETS_KEY=
# İlk yönetici hesabının şifresi (yalnız hesap yoksa kullanılır).
ADMIN_INITIAL_PASSWORD=
CORS_ORIGINS=http://localhost:5175
TRUSTED_PROXY_HOPS=0
TURNSTILE_ENABLED=false
TURNSTILE_SECRET=
SWAGGER_ENABLED=true

# ── Uygulama adresi ve e-posta ──────────────────────────────────────────────
APP_BASE_URL=http://localhost:5175
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Waydee

# ── Google ile giriş (OAuth 2.0) ────────────────────────────────────────────
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Ödeme (Polar) ───────────────────────────────────────────────────────────
# Yerelde `mock`: gerçek tahsilat olmadan tüm akış denenebilir.
# Üretimde `polar` zorunludur; webhook'lar Standard Webhooks imzasıyla doğrulanır.
PAYMENT_PROVIDER=mock
PAYMENT_ALLOW_MOCK=false
PAYMENT_RETURN_URL=http://localhost:5175/payment/return
POLAR_SERVER=sandbox
POLAR_API_KEY=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_PRO_YEARLY=
POLAR_PRODUCT_PREMIUM_MONTHLY=
POLAR_PRODUCT_PREMIUM_YEARLY=

# ── Harita ──────────────────────────────────────────────────────────────────
# Yalnız GENEL (pk.) anahtar; asıl değer yönetim panelinden de değiştirilebilir.
MAPBOX_ACCESS_TOKEN=

# ── Yapay zekâ ──────────────────────────────────────────────────────────────
# AI Stüdyo — görsel üretimi (fal.ai). Boşsa stüdyo kapalıdır ve kredi düşmez.
FAL_ENABLED=true
FAL_API_KEY=
FAL_MODEL=fal-ai/bytedance/seedream/v4/edit
FAL_UPSCALE_MODEL=fal-ai/esrgan
# Etiket önerisi — ürün algılama (OpenAI uyumlu görsel-dil modeli).
# Boşsa sunucu içi saliency algoritması kullanılır.
VISION_ENABLED=true
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini
# Waydee Agent (Claude / OpenAI) anahtarları ortamda DEĞİL, yönetim panelinden
# girilir ve veritabanında şifreli saklanır.

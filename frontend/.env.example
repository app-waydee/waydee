# Waydee Frontend — derleme zamanı değişkenleri (Vite)
# Bu değerler tarayıcıya gömülür; GİZLİ DEĞİLDİR. Üretimde Docker build-arg olarak verilir.

# Cloudflare Turnstile site anahtarı (boşsa bot doğrulaması çizilmez).
VITE_TURNSTILE_SITE_KEY=
# Mapbox genel anahtarı — yedek; asıl değer `GET /api/v1/config` ile sunucudan gelir.
VITE_MAPBOX_TOKEN=

# Çalışma zamanı (nginx konteyneri): /api ve /ws isteklerinin iletileceği backend.
BACKEND_URL=http://waydee-backend:8091
